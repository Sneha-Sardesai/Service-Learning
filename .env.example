PORT=5000
VITE_API_BASE_URL=/api
DB_HOST=localhost
DB_PORT=3306
DB_NAME=csr_research
DB_USER=csr_app
DB_PASSWORD=replace_with_a_local_password

# Optional; local extraction does not require this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

PYTHON_EXECUTABLE=
CRAWL_USER_AGENT=ServiceLearningCSRResearcher/1.0 (educational research)
CRAWL_MIN_DELAY_SECONDS=1
CRAWL_ALLOWED_SUBDOMAINS=
# Only add exact third-party hosts after independently verifying their company relationship.
CRAWL_ALLOWED_EXTERNAL_HOSTS=
MAX_CRAWL_PAGES=80
MAX_CRAWL_DEPTH=4
CRAWL_TIMEOUT_SECONDS=15
CRAWL_MAX_DURATION_SECONDS=900
MAX_HTML_BYTES=3000000
MAX_DOCUMENT_BYTES=20971520
MAX_TOTAL_DOCUMENT_BYTES=62914560
MAX_DOCUMENTS_PER_RUN=12
DOCUMENT_CACHE_TTL_SECONDS=86400
DOCUMENT_STORAGE_DIR=
RESEARCH_TIMEOUT_MS=1200000
